languagesystem DFLT dflt;
languagesystem latn dflt;

# --- calidad.py ---

@TopMarks = [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];

# la i, la j y la į pierden el punto si llevan un acento encima
lookup SoftDotted {
    sub i' @TopMarks by dotlessi;
    sub j' @TopMarks by uni0237;
    sub iogonek' @TopMarks by iogonek.dotless;
} SoftDotted;

feature ccmp {
    lookup SoftDotted;
} ccmp;
